model Assessment {
  isReassessment        Boolean                @default(false)
  originalAssessmentId  String?
  reassessmentStudentId String?
  id                    String                 @id @default(cuid())
  assessmentName        String
  branchCourseId        String
  moduleId              String
  branchBatchId         String
  batchCycleId          String?
  totalMarks            Int
  startDate             DateTime
  endDate               DateTime
  details               String?
  status                String                 @default("ACTIVE")
  cancelledAt           DateTime?
  cancelledBy           String?
  facultyId             String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  branchCourse          BranchCourse           @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  module                BranchCourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  branchBatch           BranchBatch            @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)

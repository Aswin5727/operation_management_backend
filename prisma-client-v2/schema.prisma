  BRANCH_INVITATION_RESENT
  BRANCH_LOGIN
  BRANCH_FACULTY_LOGIN
  FACULTY_COURSE_ASSIGNED
  COURSE_EDIT_REQUEST
  COURSE_EDIT_REQUEST_ACCEPTED
  COURSE_EDIT_REQUEST_REJECTED
  COURSE_EDIT_MODULE_UPDATED

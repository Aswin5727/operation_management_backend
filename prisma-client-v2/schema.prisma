  @@unique([assessmentId, branchStudentId])
  @@index([assessmentId, status])
  @@index([branchStudentId])
}

model Exam {
  isRetest         Boolean            @default(false)
  originalTestId   String?
  retestStudentId  String?
  id               String             @id @default(cuid())
  title            String             @default("MCQ Test")
  branchCourseId   String
  moduleId         String
  facultyId        String
  marksPerQuestion Int
  totalQuestions   Int
  totalMarks       Int
  status           String             @default("SCHEDULED")
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  branchCourse     BranchCourse       @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  module           BranchCourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  faculty          User               @relation("ExamFaculty", fields: [facultyId], references: [id])
  schedules        ExamSchedule[]
  questions        ExamQuestion[]
  attempts         ExamAttempt[]

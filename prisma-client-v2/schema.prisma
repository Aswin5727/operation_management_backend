generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client-v2"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                         @id @default(cuid())
  userCode                       String                         @unique
  fullName                       String
  email                          String                         @unique
  phone                          String?                        @unique
  address                        String?
  role                           UserRole
  active                         Boolean                        @default(true)
  passwordHash                   String
  passwordChangedAt              DateTime?
  refreshTokenVersion            Int                            @default(0)
  failedLoginCount               Int                            @default(0)
  failedLoginWindowExpiresAt     DateTime?
  lockedUntil                    DateTime?
  lastLoginAt                    DateTime?
  lastLogoutAt                   DateTime?
  lastLoginIp                    String?
  lastLoginUserAgent             String?
  createdBy                      String?
  updatedBy                      String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  batchFacultyAssignments        BatchFacultyAssignment[]
  managedBranch                  Branch?                        @relation("BranchAdminUser")
  facultyAttendanceSessions      FacultyAttendanceSession[]
  facultyAttendanceDays          FacultyAttendanceDay[]
  facultyAttendanceBatchWork     FacultyAttendanceBatchWork[]
  facultyTodayWorkEntries        FacultyTodayWorkEntry[]
  loginEvents                    LoginEvent[]
  targetedNotifications          Notification[]                 @relation("NotificationTargetUser")
  passwordResetTokens            PasswordResetToken[]
  markedStudentAttendances       StudentAttendance[]
  markedBranchStudentAttendances BranchStudentAttendance[]
  dashboardWidgetPreferences     UserDashboardWidget[]
  facultyLeaveRequests           FacultyLeaveRequest[]
  createdExams                   Exam[]                         @relation("ExamFaculty")
  examAttempts                   ExamAttempt[]
  createdAssessments             Assessment[]                   @relation("AssessmentFaculty")
  evaluatedSubmissions           AssessmentSubmission[]         @relation("AssessmentEvaluator")
  facultySkillAssignments        FacultySkillAssignment[]       @relation("FacultySkillUserAssignments")
  academicTestReportSubmissions  AcademicTestReportSubmission[]
  salesAdminBranches             SalesAdminBranch[]             @relation("SalesAdminUserBranches")
  assignedLeads                  Lead[]                         @relation("LeadAssignee")
  createdSalesCrmBatchRequests   SalesCrmBatchRequest[]         @relation("SalesCrmBatchRequestCreator")
  assignedSalesCrmBatchRequests  SalesCrmBatchRequest[]         @relation("SalesCrmBatchRequestAssignee")
  createdLeads                   Lead[]                         @relation("LeadCreatedBy")
  updatedLeads                   Lead[]                         @relation("LeadUpdatedBy")
  leadFollowUps                  LeadFollowUp[]                 @relation("LeadFollowUpCreatedBy")
  leadActivities                 LeadActivity[]                 @relation("LeadActivityCreatedBy")
  leadStageChanges               LeadStageHistory[]             @relation("LeadStageHistoryCreatedBy")
  leadRecordings                 LeadRecording[]                @relation("LeadRecordingCreatedBy")
  followUpReminders              FollowUpReminder[]             @relation("FollowUpReminderRecipient")

  @@index([role])
  @@index([active])
}

model DashboardWidget {
  id           String                @id @default(cuid())
  widgetKey    String                @unique
  widgetName   String
  category     String
  description  String                @default("")
  allowedRoles String[]
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  preferences  UserDashboardWidget[]

  @@index([isActive])
}

model UserDashboardWidget {
  id           String          @id @default(cuid())
  userId       String
  widgetId     String
  isVisible    Boolean         @default(true)
  displayOrder Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  widget       DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetId])
  @@index([userId, displayOrder])
  @@index([widgetId])
}

model Branch {
  id                         String                      @id @default(cuid())
  branchId                   String                      @unique
  branchName                 String
  branchAdminName            String
  branchEmail                String                      @unique
  branchPhone                String                      @unique
  branchAddress              String
  status                     RecordStatus                @default(ACTIVE)
  adminUserId                String?                     @unique
  createdBy                  String?
  updatedBy                  String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  timezone                   String                      @default("Asia/Kolkata")
  branchCity                 String                      @default("")
  branchCountry              String                      @default("")
  branchCountryCode          String                      @default("")
  branchState                String                      @default("")
  branchStateCode            String                      @default("")
  adminUser                  User?                       @relation("BranchAdminUser", fields: [adminUserId], references: [id])
  branchCourses              BranchCourse[]
  branchBatches              BranchBatch[]
  branchInstallmentTemplates BranchInstallmentTemplate[]
  branchFaculties            BranchFaculty[]
  branchStudents             BranchStudent[]
  studentEnrollments         BranchStudentCourse[]
  calendarHolidays           BranchCalendarHoliday[]
  calendarLeaves             BranchCalendarLeave[]
  ledgerEntries              BranchStudentLedgerEntry[]
  payments                   BranchStudentPayment[]
  courses                    Course[]
  facultySkillAssignments    FacultySkillAssignment[]    @relation("FacultySkillBranchAssignments")
  facultyLeaveRequests       FacultyLeaveRequest[]
  salesAdminBranches         SalesAdminBranch[]
  salesCrmBatchRequests      SalesCrmBatchRequest[]
  leads                      Lead[]

  @@index([status])
  @@index([branchName])
  @@index([branchAdminName])
}

model SalesAdminBranch {
  id           String   @id @default(cuid())
  salesAdminId String
  branchId     String
  createdAt    DateTime @default(now())
  salesAdmin   User     @relation("SalesAdminUserBranches", fields: [salesAdminId], references: [id], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([salesAdminId, branchId])
  @@index([salesAdminId])
  @@index([branchId])
}

model LoginEvent {
  id        String         @id @default(cuid())
  userId    String?
  eventType LoginEventType
  success   Boolean        @default(true)
  ipAddress String?
  userAgent String?
  reason    String?
  meta      Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId, eventType])
}

model Notification {
  id                       String             @id @default(cuid())
  kind                     NotificationKind
  tone                     String             @default("blue")
  title                    String
  message                  String
  actionLabel              String?
  targetBranchId           String?
  targetBranchEmail        String?
  targetBranchName         String?
  read                     Boolean            @default(false)
  readAt                   DateTime?
  createdBy                String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  targetUserId             String?
  branchCourseId           String?
  branchCourseName         String?
  facultyId                String?
  facultyName              String?
  moduleId                 String?
  moduleName               String?
  requestDescription       String?
  requestId                String?
  leaveRequestId           String?
  requestReason            String?
  requestStatus            String?
  requestTitle             String?
  examId                   String?
  examScheduleId           String?
  academicTestId           String?
  assessmentId             String?
  batchId                  String?
  facultySkillAssignmentId String?
  subModuleId              String?
  subModuleName            String?
  request                  CourseEditRequest? @relation("CourseEditRequestNotifications", fields: [requestId], references: [id])
  targetUser               User?              @relation("NotificationTargetUser", fields: [targetUserId], references: [id])

  @@index([kind, createdAt])
  @@index([read, createdAt])
  @@index([targetUserId, read])
  @@index([requestId])
  @@index([targetBranchId])
  @@index([targetBranchEmail])
  @@index([targetBranchName])
  @@index([targetUserId, examId, examScheduleId])
  @@index([targetUserId, assessmentId])
  @@index([facultySkillAssignmentId])
}

model SalesAdminAdmissionReminder {
  id               String   @id @default(cuid())
  salesAdminId     String
  notificationType String   @default("PENDING_HOT_ADMISSIONS")
  reminderDate     String   @db.VarChar(10)
  notificationId   String?  @unique
  createdAt        DateTime @default(now())

  @@unique([salesAdminId, notificationType, reminderDate], map: "SalesAdminAdmissionReminder_daily_key")
  @@index([salesAdminId, reminderDate])
}

model SalesCrmBatchRequest {
  id                String                     @id @default(cuid())
  leadId            String
  branchId          String
  courseId          String
  requestedById     String
  assignedToId      String?
  requestedMode     String?
  requestedSchedule String?
  requestDetails    String
  status            SalesCrmBatchRequestStatus @default(PENDING)
  activeKey         String?                    @unique
  resolvedBatchId   String?
  statusUpdatedById String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lead              Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  branch            Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course            BranchCourse               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  requestedBy       User                       @relation("SalesCrmBatchRequestCreator", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo        User?                      @relation("SalesCrmBatchRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBatch     BranchBatch?               @relation(fields: [resolvedBatchId], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@index([requestedById, status, createdAt])
  @@index([leadId, courseId])
}

model CourseEditRequest {
  id               String                  @id @default(cuid())
  branchCourseId   String
  branchId         String?
  facultyUserId    String?
  facultyId        String?
  facultyName      String?
  facultyEmail     String?
  title            String
  reason           String
  description      String?
  status           CourseEditRequestStatus @default(PENDING)
  requestedModules Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  editingStartedAt DateTime?
  completedAt      DateTime?
  responseNote     String?
  updatedModules   Json?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  notifications    Notification[]          @relation("CourseEditRequestNotifications")

  @@index([branchCourseId, status, createdAt])
  @@index([branchId, status])
  @@index([facultyUserId, status])
  @@index([reviewedByUserId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Course {
  id                       String                    @id @default(cuid())
  name                     String
  nameKey                  String
  description              String?
  feeReference             String?
  mode                     String
  duration                 Int?
  hours                    Int?
  actualFees               Int?
  registrationFees         Int?
  discount                 Int?
  afterDiscount            Int?
  installmentCount         Int                       @default(2)
  installment1             Int?
  installment2             Int?
  installment3             Int?
  status                   RecordStatus              @default(ACTIVE)
  statusChangedAt          DateTime?
  statusChangedBy          String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  installments             Json?
  branchId                 String?
  courseCode               String?
  batches                  Batch[]
  branchFaculties          BranchFaculty[]
  branch                   Branch?                   @relation(fields: [branchId], references: [id])
  modules                  CourseModule[]
  statusHistory            CourseStatusHistory[]
  facultyBatchEntries      FacultyBatchEntry[]
  facultyCourseAssignments FacultyCourseAssignment[]
  facultyProfiles          FacultyProfile[]
  students                 StudentProfile[]

  @@index([branchId])
  @@index([nameKey])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
}

model BranchCourse {
  id                             String                         @id @default(cuid())
  branchId                       String
  courseCode                     String
  name                           String
  nameKey                        String
  courseType                     String                         @default("")
  academicTestCount              Int                            @default(0)
  description                    String?
  mode                           String
  duration                       Int?
  hours                          Int?
  actualFees                     Int?
  registrationFees               Int?
  discount                       Int?
  afterDiscount                  Int?
  paymentPlans                   Json?
  paymentPlanSelections          Json?
  status                         RecordStatus                   @default(ACTIVE)
  createdBy                      String?
  updatedBy                      String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  branch                         Branch                         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  installmentTemplate            BranchInstallmentTemplate?
  modules                        BranchCourseModule[]
  branchFaculties                BranchFaculty[]
  facultyAssignments             BranchFacultyCourse[]
  branchBatches                  BranchBatch[]
  branchStudents                 BranchStudent[]
  studentEnrollments             BranchStudentCourse[]
  facultyTodayWorkEntries        FacultyTodayWorkEntry[]
  facultyTodayWorkStudentEntries FacultyTodayWorkStudentEntry[]
  exams                          Exam[]
  assessments                    Assessment[]
  academicTests                  AcademicTest[]
  academicQuestionPapers         AcademicQuestionPaper[]
  academicTestProjects           AcademicTestProject[]
  leads                          Lead[]
  salesCrmBatchRequests          SalesCrmBatchRequest[]

  @@unique([branchId, nameKey])
  @@unique([branchId, courseCode])
  @@index([branchId])
  @@index([branchId, courseType])
  @@index([status])
  @@index([createdAt])
}

model BranchCourseModule {
  id                    String                  @id @default(cuid())
  branchCourseId        String
  title                 String
  titleKey              String
  description           String?
  sequenceNo            Int
  percentageBasisPoints Int                     @default(0)
  status                RecordStatus            @default(ACTIVE)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  branchCourse          BranchCourse            @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  submodules            BranchCourseSubmodule[]
  exams                 Exam[]
  assessments           Assessment[]

  @@unique([branchCourseId, sequenceNo])
  @@unique([branchCourseId, titleKey])
  @@index([branchCourseId, status])
  @@index([branchCourseId, createdAt])
}

model BranchCourseSubmodule {
  id                    String             @id @default(cuid())
  branchCourseModuleId  String
  title                 String
  titleKey              String
  description           String?
  sequenceNo            Int
  percentageBasisPoints Int                @default(0)
  status                RecordStatus       @default(ACTIVE)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  branchCourseModule    BranchCourseModule @relation(fields: [branchCourseModuleId], references: [id], onDelete: Cascade)

  @@unique([branchCourseModuleId, sequenceNo])
  @@unique([branchCourseModuleId, titleKey])
  @@index([branchCourseModuleId, status])
  @@index([branchCourseModuleId, createdAt])
}

model CourseModule {
  id              String       @id @default(cuid())
  courseId        String
  title           String
  titleKey        String
  description     String?
  sequenceNo      Int
  status          RecordStatus @default(ACTIVE)
  statusChangedAt DateTime?
  statusChangedBy String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sequenceNo])
  @@unique([courseId, titleKey])
  @@index([courseId, status])
}

model Batch {
  id                 String                   @id @default(cuid())
  courseId           String
  batchName          String
  batchNameKey       String                   @unique
  description        String?
  startDate          String
  endDate            String
  startTime          String
  endTime            String
  capacity           Int
  enrolledCount      Int                      @default(0)
  status             BatchStatus              @default(PLANNED)
  statusChangedAt    DateTime?
  statusChangedBy    String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  course             Course                   @relation(fields: [courseId], references: [id])
  facultyAssignments BatchFacultyAssignment[]
  statusHistory      BatchStatusHistory[]

  @@index([courseId, status])
  @@index([startDate])
  @@index([endDate])
}

model BatchFacultyAssignment {
  id           String           @id @default(cuid())
  batchId      String
  facultyId    String
  assignedDate String
  assignedAt   DateTime         @default(now())
  releasedAt   DateTime?
  status       AssignmentStatus @default(ACTIVE)
  notes        String?
  assignedBy   String?
  releasedBy   String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  batch        Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  faculty      User             @relation(fields: [facultyId], references: [id])

  @@index([batchId, status])
  @@index([facultyId, status])
  @@index([assignedDate])
}

model BranchBatch {
  id                          String                      @id @default(cuid())
  branchId                    String
  branchCourseId              String
  branchFacultyId             String
  batchId                     String
  courseId                    String
  courseName                  String
  facultyId                   String
  facultyName                 String
  facultyEmail                String
  batchName                   String
  startTime                   String
  startPeriod                 String
  endTime                     String
  endPeriod                   String
  batchTiming                 String
  totalSeats                  Int
  offlineSeats                Int                         @default(0)
  weekType                    String?
  mode                        String?
  courseStartDate             String?
  courseEndDate               String?
  weeklyOffDay                String?
  sequenceNo                  Int                         @default(1)
  status                      RecordStatus                @default(ACTIVE)
  createdBy                   String?
  updatedBy                   String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  branch                      Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchCourse                BranchCourse                @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchFaculty               BranchFaculty               @relation(fields: [branchFacultyId], references: [id], onDelete: Cascade)
  examSchedules               ExamSchedule[]
  assessments                 Assessment[]
  academicTestBatches         AcademicTestBatch[]
  academicQuestionPapers      AcademicQuestionPaper[]
  academicTestProjects        AcademicTestProject[]
  academicTestCycles          AcademicTestCycle[]
  cycles                      BatchCycle[]
  resolvedSalesCrmRequests    SalesCrmBatchRequest[]
  academicTestReportHistories AcademicTestReportHistory[]

  @@unique([branchId, courseId, facultyId, batchId])
  @@index([branchId])
  @@index([branchCourseId])
  @@index([branchFacultyId])
  @@index([courseId])
  @@index([facultyId])
  @@index([branchId, batchId])
  @@index([status])
  @@index([courseId, weekType, mode])
}

enum AcademicTestType {
  TEST
  PROJECT
  TEST_AND_PROJECT
}

enum AcademicPreparationStatus {
  DRAFT
  PREPARED
}

model AcademicTest {
  id             String              @id @default(cuid())
  branchCourseId String
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  branchCourse   BranchCourse        @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  items          AcademicTestItem[]
  batches        AcademicTestBatch[]

  @@index([branchCourseId])
  @@index([createdBy])
}

model AcademicTestItem {
  id                          String                      @id @default(cuid())
  academicTestId              String
  sequence                    Int
  testType                    AcademicTestType
  requiredProgress            Int                         @default(0)
  testDate                    String?
  testStartTime               String?
  testEndTime                 String?
  projectStartDate            String?
  projectEndDate              String?
  academicTest                AcademicTest                @relation(fields: [academicTestId], references: [id], onDelete: Cascade)
  questionPapers              AcademicQuestionPaper[]
  projects                    AcademicTestProject[]
  cycles                      AcademicTestCycle[]
  academicTestReportHistories AcademicTestReportHistory[]

  @@unique([academicTestId, sequence])
  @@index([academicTestId])
}

model AcademicTestBatch {
  id             String       @id @default(cuid())
  academicTestId String
  branchBatchId  String
  academicTest   AcademicTest @relation(fields: [academicTestId], references: [id], onDelete: Cascade)
  branchBatch    BranchBatch  @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)

  @@unique([academicTestId, branchBatchId])
  @@index([branchBatchId])
}

model AcademicQuestionPaper {
  id                 String                    @id @default(cuid())
  academicTestItemId String
  branchCourseId     String
  branchBatchId      String
  cycleId            String
  createdBy          String
  status             AcademicPreparationStatus @default(DRAFT)
  marksPerQuestion   Int                       @default(1)
  totalQuestions     Int                       @default(0)
  totalMarks         Int                       @default(0)
  passMark           Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  academicTestItem   AcademicTestItem          @relation(fields: [academicTestItemId], references: [id], onDelete: Cascade)
  branchCourse       BranchCourse              @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchBatch        BranchBatch               @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)
  questions          AcademicQuestion[]
  cycle              AcademicTestCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([academicTestItemId, branchBatchId, cycleId])
  @@index([branchCourseId, branchBatchId])
  @@index([createdBy])
}

model AcademicQuestion {
  id              String                @id @default(cuid())
  questionPaperId String
  questionNumber  Int
  questionType    String                @default("MCQ")
  questionText    String
  optionA         String                @default("")
  optionB         String                @default("")
  optionC         String                @default("")
  optionD         String                @default("")
  correctAnswer   String                @default("")
  marks           Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  questionPaper   AcademicQuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  @@unique([questionPaperId, questionNumber])
  @@index([questionPaperId])
}

model AcademicTestProject {
  id                  String                    @id @default(cuid())
  academicTestItemId  String
  branchCourseId      String
  branchBatchId       String
  cycleId             String
  createdBy           String
  status              AcademicPreparationStatus @default(DRAFT)
  projectTitle        String                    @default("")
  projectDescription  String                    @default("")
  projectRequirements String?
  projectMarks        Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  academicTestItem    AcademicTestItem          @relation(fields: [academicTestItemId], references: [id], onDelete: Cascade)
  branchCourse        BranchCourse              @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchBatch         BranchBatch               @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)
  cycle               AcademicTestCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([academicTestItemId, branchBatchId, cycleId])
  @@index([branchCourseId, branchBatchId])
  @@index([createdBy])
}

model AcademicScheduledTest {
  id                 String            @id @default(cuid())
  academicTestItemId String
  branchCourseId     String
  branchBatchId      String
  cycleId            String
  facultyId          String
  questionPaperId    String?
  testNumber         Int
  testDate           String?
  startTime          String?
  endTime            String?
  projectStartDate   String?
  projectEndDate     String?
  status             String            @default("SCHEDULED")
  isRetest           Boolean           @default(false)
  originalScheduleId String?
  parentScheduleId   String?
  attemptNumber      Int               @default(1)
  retestStudentId    String?
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  cycle              AcademicTestCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([academicTestItemId, branchBatchId, cycleId])
  @@index([branchBatchId, testDate])
  @@index([facultyId])
  @@index([questionPaperId])
  @@index([originalScheduleId, retestStudentId])
  @@index([parentScheduleId])
}

model AcademicTestCycle {
  id                 String                  @id @default(cuid())
  academicTestItemId String
  branchBatchId      String
  cycleNumber        Int
  batchCycleId       String
  status             String                  @default("ACTIVE")
  createdBy          String
  createdAt          DateTime                @default(now())
  academicTestItem   AcademicTestItem        @relation(fields: [academicTestItemId], references: [id], onDelete: Cascade)
  branchBatch        BranchBatch             @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)
  batchCycle         BatchCycle              @relation(fields: [batchCycleId], references: [id], onDelete: Cascade)
  questionPapers     AcademicQuestionPaper[]
  projects           AcademicTestProject[]
  schedules          AcademicScheduledTest[]

  @@unique([academicTestItemId, branchBatchId, cycleNumber])
  @@index([academicTestItemId, branchBatchId, status])
}

model BatchCycle {
  id                 String                      @id @default(cuid())
  batchId            String
  cycleNumber        Int
  cycleName          String
  status             String                      @default("ACTIVE")
  startDate          String?
  endDate            String?
  completedAt        DateTime?
  freezeUntil        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  batch              BranchBatch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  enrollments        BranchStudentCourse[]

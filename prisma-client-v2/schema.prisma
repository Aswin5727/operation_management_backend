  @@index([branchBatchId, startDate, endDate])
  @@index([batchCycleId])
  @@index([branchCourseId, moduleId])
  @@index([originalAssessmentId])
  @@index([reassessmentStudentId])
  @@index([isReassessment, reassessmentStudentId])
}

model AssessmentSubmission {
  id                 String        @id @default(cuid())
  assessmentId       String
  branchStudentId    String
  response           String?
  screenshotUrl      String?
  screenshotFileName String?
  screenshotMimeType String?
  submittedAt        DateTime?
  status             String        @default("NOT_SUBMITTED")
  evaluationStatus   String        @default("Pending")

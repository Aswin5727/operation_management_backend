  retests          Exam[]             @relation("ExamRetestSource")
  retestStudent    BranchStudent?     @relation("ExamRetestStudent", fields: [retestStudentId], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([branchCourseId])
  @@index([moduleId])
  @@index([originalTestId])
  @@index([retestStudentId])
  @@index([isRetest, retestStudentId])
}

model ExamSchedule {
  id            String        @id @default(cuid())
  examId        String
  branchBatchId String
  batchCycleId  String?
  testDate      String
  startTime     String
  endTime       String
  status        String        @default("SCHEDULED")
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  branchBatch   BranchBatch   @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)
  batchCycle    BatchCycle?   @relation(fields: [batchCycleId], references: [id], onDelete: SetNull)
  attempts      ExamAttempt[]

  @@unique([examId, branchBatchId])
  @@index([branchBatchId, testDate])
  @@index([batchCycleId])
  @@index([examId])
}

model ExamQuestion {
  id            String       @id @default(cuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  questionOrder Int
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       ExamAnswer[]

  @@unique([examId, questionOrder])
  @@index([examId])
}

model ExamAttempt {
  id                  String        @id @default(cuid())
  examId              String
  scheduleId          String
  branchStudentId     String
  studentUserId       String?
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  timeTakenSeconds    Int?
  status              String        @default("IN_PROGRESS")
  totalQuestions      Int
  attemptedQuestions  Int           @default(0)
  correctAnswers      Int           @default(0)
  wrongAnswers        Int           @default(0)
  unansweredQuestions Int           @default(0)
  totalMarks          Int
  obtainedMarks       Int           @default(0)
  percentage          Float         @default(0)
  exam                Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  schedule            ExamSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  branchStudent       BranchStudent @relation(fields: [branchStudentId], references: [id], onDelete: Cascade)
  studentUser         User?         @relation(fields: [studentUserId], references: [id])
  answers             ExamAnswer[]

  @@unique([scheduleId, branchStudentId])
  @@index([branchStudentId])
  @@index([examId])
  @@index([scheduleId])
  @@index([studentUserId])
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean      @default(false)
  marksAwarded   Int          @default(0)
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

enum LeadStatus {
  DRAFT
  ACTIVE
  FOLLOW_UP
  CONVERTED
  CLOSED
  OTHER
}

enum LeadStage {
  COLD
  WARM
  HOT
  CLOSED
  OTHER
}

model Lead {
  id                    String                 @id @default(cuid())
  leadId                String                 @unique
  studentName           String
  phoneNumber           String
  alternativeNumber     String?
  email                 String?
  qualification         String?
  location              String?
  callType              String
  otherCallType         String?
  status                LeadStatus             @default(DRAFT)
  otherStatus           String?
  stage                 LeadStage              @default(COLD)
  otherStage            String?
  courseId              String
  otherCourse           String?
  nextFollowUpDate      DateTime?
  nextFollowUpTime      String?
  lastCallStatus        String?
  branchId              String
  leadSource            String
  otherLeadSource       String?
  referredBy            String?
  referredName          String?
  paymentStatus         String                 @default("NOT_PAID")
  paymentAmount         Float?
  admissionStatus       String                 @default("PENDING")
  trainingMode          String?
  classSchedule         String?
  courseMode            String?
  locationDistance      String?
  otherLocationDistance String?
  leadDate              DateTime
  assignedToId          String?
  createdById           String
  updatedById           String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  course                BranchCourse           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTo            User?                  @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy             User                   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User?                  @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  followUps             LeadFollowUp[]
  stageHistory          LeadStageHistory[]
  activities            LeadActivity[]
  recordings            LeadRecording[]
  convertedStudent      BranchStudent?         @relation("LeadBranchStudentAdmission")
  followUpReminders     FollowUpReminder[]
  salesCrmBatchRequests SalesCrmBatchRequest[]

  @@index([branchId, createdAt])
  @@index([courseId])
  @@index([stage, status])
  @@index([assignedToId, status])
  @@index([phoneNumber])
  @@index([leadDate])
}

model LeadFollowUp {
  id               String          @id @default(cuid())
  leadId           String
  followUpDate     DateTime
  followUpType     String
  callStatus       String
  notes            String
  nextFollowUpDate DateTime?
  nextFollowUpTime String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy        User            @relation("LeadFollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recordings       LeadRecording[]

  @@index([leadId, followUpDate])
  @@index([nextFollowUpDate])
}

model LeadStageHistory {
  id          String     @id @default(cuid())
  leadId      String
  fromStage   LeadStage?
  toStage     LeadStage
  createdById String
  createdAt   DateTime   @default(now())
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("LeadStageHistoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id            String   @id @default(cuid())
  leadId        String
  action        String
  previousValue Json?
  newValue      Json?
  createdById   String
  createdAt     DateTime @default(now())
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("LeadActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
}

model LeadRecording {
  id           String        @id @default(cuid())
  leadId       String
  followUpId   String?
  originalName String
  storageKey   String        @unique
  mimeType     String
  sizeBytes    Int
  createdById  String
  createdAt    DateTime      @default(now())
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUp     LeadFollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("LeadRecordingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])

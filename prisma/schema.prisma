generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client-v2"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                       @id @default(cuid())
  userCode                       String                       @unique
  fullName                       String
  email                          String                       @unique
  phone                          String?                      @unique
  role                           UserRole
  active                         Boolean                      @default(true)
  passwordHash                   String
  passwordChangedAt              DateTime?
  refreshTokenVersion            Int                          @default(0)
  failedLoginCount               Int                          @default(0)
  failedLoginWindowExpiresAt     DateTime?
  lockedUntil                    DateTime?
  lastLoginAt                    DateTime?
  lastLogoutAt                   DateTime?
  lastLoginIp                    String?
  lastLoginUserAgent             String?
  createdBy                      String?
  updatedBy                      String?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  batchFacultyAssignments        BatchFacultyAssignment[]
  managedBranch                  Branch?                      @relation("BranchAdminUser")
  facultyAttendanceSessions      FacultyAttendanceSession[]
  facultyAttendanceDays          FacultyAttendanceDay[]
  facultyAttendanceBatchWork     FacultyAttendanceBatchWork[]
  facultyTodayWorkEntries        FacultyTodayWorkEntry[]
  loginEvents                    LoginEvent[]
  targetedNotifications          Notification[]               @relation("NotificationTargetUser")
  passwordResetTokens            PasswordResetToken[]
  markedStudentAttendances       StudentAttendance[]
  markedBranchStudentAttendances BranchStudentAttendance[]
  dashboardWidgetPreferences     UserDashboardWidget[]
  facultyLeaveRequests           FacultyLeaveRequest[]
  createdExams                   Exam[]                       @relation("ExamFaculty")
  examAttempts                   ExamAttempt[]
  createdAssessments             Assessment[]                 @relation("AssessmentFaculty")
  evaluatedSubmissions           AssessmentSubmission[]       @relation("AssessmentEvaluator")

  @@index([role])
  @@index([active])
}

model DashboardWidget {
  id           String                @id @default(cuid())
  widgetKey    String                @unique
  widgetName   String
  category     String
  description  String                @default("")
  allowedRoles String[]
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  preferences  UserDashboardWidget[]

  @@index([isActive])
}

model UserDashboardWidget {
  id           String          @id @default(cuid())
  userId       String
  widgetId     String
  isVisible    Boolean         @default(true)
  displayOrder Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  widget       DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetId])
  @@index([userId, displayOrder])
  @@index([widgetId])
}

model Branch {
  id                         String                      @id @default(cuid())
  branchId                   String                      @unique
  branchName                 String
  branchAdminName            String
  branchEmail                String                      @unique
  branchPhone                String                      @unique
  branchAddress              String
  status                     RecordStatus                @default(ACTIVE)
  adminUserId                String?                     @unique
  createdBy                  String?
  updatedBy                  String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  timezone                   String                      @default("Asia/Kolkata")
  branchCity                 String                      @default("")
  branchCountry              String                      @default("")
  branchCountryCode          String                      @default("")
  branchState                String                      @default("")
  branchStateCode            String                      @default("")
  adminUser                  User?                       @relation("BranchAdminUser", fields: [adminUserId], references: [id])
  branchCourses              BranchCourse[]
  branchBatches              BranchBatch[]
  branchInstallmentTemplates BranchInstallmentTemplate[]
  branchFaculties            BranchFaculty[]
  branchStudents             BranchStudent[]
  studentEnrollments         BranchStudentCourse[]
  calendarHolidays           BranchCalendarHoliday[]
  calendarLeaves             BranchCalendarLeave[]
  ledgerEntries              BranchStudentLedgerEntry[]
  payments                   BranchStudentPayment[]
  courses                    Course[]
  facultyLeaveRequests       FacultyLeaveRequest[]

  @@index([status])
  @@index([branchName])
  @@index([branchAdminName])
}

model LoginEvent {
  id        String         @id @default(cuid())
  userId    String?
  eventType LoginEventType
  success   Boolean        @default(true)
  ipAddress String?
  userAgent String?
  reason    String?
  meta      Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId, eventType])
}

model Notification {
  id                 String             @id @default(cuid())
  kind               NotificationKind
  tone               String             @default("blue")
  title              String
  message            String
  actionLabel        String?
  targetBranchId     String?
  targetBranchEmail  String?
  targetBranchName   String?
  read               Boolean            @default(false)
  readAt             DateTime?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  targetUserId       String?
  branchCourseId     String?
  branchCourseName   String?
  facultyId          String?
  facultyName        String?
  moduleId           String?
  moduleName         String?
  requestDescription String?
  requestId          String?
  leaveRequestId     String?
  requestReason      String?
  requestStatus      String?
  requestTitle       String?
  examId             String?
  examScheduleId     String?
  academicTestId     String?
  assessmentId       String?
  batchId            String?
  subModuleId        String?
  subModuleName      String?
  request            CourseEditRequest? @relation("CourseEditRequestNotifications", fields: [requestId], references: [id])
  targetUser         User?              @relation("NotificationTargetUser", fields: [targetUserId], references: [id])

  @@index([kind, createdAt])
  @@index([read, createdAt])
  @@index([targetUserId, read])
  @@index([requestId])
  @@index([targetBranchId])
  @@index([targetBranchEmail])
  @@index([targetBranchName])
  @@index([targetUserId, examId, examScheduleId])
  @@index([targetUserId, assessmentId])
}

model CourseEditRequest {
  id               String                  @id @default(cuid())
  branchCourseId   String
  branchId         String?
  facultyUserId    String?
  facultyId        String?
  facultyName      String?
  facultyEmail     String?
  title            String
  reason           String
  description      String?
  status           CourseEditRequestStatus @default(PENDING)
  requestedModules Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  editingStartedAt DateTime?
  completedAt      DateTime?
  responseNote     String?
  updatedModules   Json?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  notifications    Notification[]          @relation("CourseEditRequestNotifications")

  @@index([branchCourseId, status, createdAt])
  @@index([branchId, status])
  @@index([facultyUserId, status])
  @@index([reviewedByUserId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Course {
  id                       String                    @id @default(cuid())
  name                     String
  nameKey                  String
  description              String?
  feeReference             String?
  mode                     String
  duration                 Int?
  hours                    Int?
  actualFees               Int?
  registrationFees         Int?
  discount                 Int?
  afterDiscount            Int?
  installmentCount         Int                       @default(2)
  installment1             Int?
  installment2             Int?
  installment3             Int?
  status                   RecordStatus              @default(ACTIVE)
  statusChangedAt          DateTime?
  statusChangedBy          String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  installments             Json?
  branchId                 String?
  courseCode               String?
  batches                  Batch[]
  branchFaculties          BranchFaculty[]
  branch                   Branch?                   @relation(fields: [branchId], references: [id])
  modules                  CourseModule[]
  statusHistory            CourseStatusHistory[]
  facultyBatchEntries      FacultyBatchEntry[]
  facultyCourseAssignments FacultyCourseAssignment[]
  facultyProfiles          FacultyProfile[]
  students                 StudentProfile[]

  @@index([branchId])
  @@index([nameKey])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
}

model BranchCourse {
  id                             String                         @id @default(cuid())
  branchId                       String
  courseCode                     String
  name                           String
  nameKey                        String
  courseType                     String                         @default("")
  academicTestCount              Int                            @default(0)
  description                    String?
  mode                           String
  duration                       Int?
  hours                          Int?
  actualFees                     Int?
  registrationFees               Int?
  discount                       Int?
  afterDiscount                  Int?
  paymentPlans                   Json?
  paymentPlanSelections          Json?
  status                         RecordStatus                   @default(ACTIVE)
  createdBy                      String?
  updatedBy                      String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  branch                         Branch                         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  installmentTemplate            BranchInstallmentTemplate?
  modules                        BranchCourseModule[]
  branchFaculties                BranchFaculty[]
  facultyAssignments             BranchFacultyCourse[]
  branchBatches                  BranchBatch[]
  branchStudents                 BranchStudent[]
  studentEnrollments             BranchStudentCourse[]
  facultyTodayWorkEntries        FacultyTodayWorkEntry[]
  facultyTodayWorkStudentEntries FacultyTodayWorkStudentEntry[]
  exams                          Exam[]
  assessments                    Assessment[]
  academicTests                  AcademicTest[]
  academicQuestionPapers         AcademicQuestionPaper[]
  academicTestProjects            AcademicTestProject[]

  @@unique([branchId, nameKey])
  @@unique([branchId, courseCode])
  @@index([branchId])
  @@index([branchId, courseType])
  @@index([status])
  @@index([createdAt])
}

model BranchCourseModule {
  id             String                  @id @default(cuid())
  branchCourseId String
  title          String
  titleKey       String
  description    String?
  sequenceNo     Int
  status         RecordStatus            @default(ACTIVE)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  branchCourse   BranchCourse            @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  submodules     BranchCourseSubmodule[]
  exams          Exam[]
  assessments    Assessment[]

  @@unique([branchCourseId, sequenceNo])
  @@unique([branchCourseId, titleKey])
  @@index([branchCourseId, status])
  @@index([branchCourseId, createdAt])
}

model BranchCourseSubmodule {
  id                   String             @id @default(cuid())
  branchCourseModuleId String
  title                String
  titleKey             String
  description          String?
  sequenceNo           Int
  status               RecordStatus       @default(ACTIVE)
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  branchCourseModule   BranchCourseModule @relation(fields: [branchCourseModuleId], references: [id], onDelete: Cascade)

  @@unique([branchCourseModuleId, sequenceNo])
  @@unique([branchCourseModuleId, titleKey])
  @@index([branchCourseModuleId, status])
  @@index([branchCourseModuleId, createdAt])
}

model CourseModule {
  id              String       @id @default(cuid())
  courseId        String
  title           String
  titleKey        String
  description     String?
  sequenceNo      Int
  status          RecordStatus @default(ACTIVE)
  statusChangedAt DateTime?
  statusChangedBy String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sequenceNo])
  @@unique([courseId, titleKey])
  @@index([courseId, status])
}

model Batch {
  id                 String                   @id @default(cuid())
  courseId           String
  batchName          String
  batchNameKey       String                   @unique
  description        String?
  startDate          String
  endDate            String
  startTime          String
  endTime            String
  capacity           Int
  enrolledCount      Int                      @default(0)
  status             BatchStatus              @default(PLANNED)
  statusChangedAt    DateTime?
  statusChangedBy    String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  course             Course                   @relation(fields: [courseId], references: [id])
  facultyAssignments BatchFacultyAssignment[]
  statusHistory      BatchStatusHistory[]

  @@index([courseId, status])
  @@index([startDate])
  @@index([endDate])
}

model BatchFacultyAssignment {
  id           String           @id @default(cuid())
  batchId      String
  facultyId    String
  assignedDate String
  assignedAt   DateTime         @default(now())
  releasedAt   DateTime?
  status       AssignmentStatus @default(ACTIVE)
  notes        String?
  assignedBy   String?
  releasedBy   String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  batch        Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  faculty      User             @relation(fields: [facultyId], references: [id])

  @@index([batchId, status])
  @@index([facultyId, status])
  @@index([assignedDate])
}

model BranchBatch {
  id              String         @id @default(cuid())
  branchId        String
  branchCourseId  String
  branchFacultyId String
  batchId         String
  courseId        String
  courseName      String
  facultyId       String
  facultyName     String
  facultyEmail    String
  batchName       String
  startTime       String
  startPeriod     String
  endTime         String
  endPeriod       String
  batchTiming     String
  totalSeats      Int
  offlineSeats    Int            @default(0)
  weekType        String?
  mode            String?
  courseStartDate String?
  courseEndDate   String?
  weeklyOffDay    String?
  sequenceNo      Int            @default(1)
  status          RecordStatus   @default(ACTIVE)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchCourse    BranchCourse   @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchFaculty   BranchFaculty  @relation(fields: [branchFacultyId], references: [id], onDelete: Cascade)
  examSchedules   ExamSchedule[]
  assessments     Assessment[]
  academicTestBatches AcademicTestBatch[]
  academicQuestionPapers AcademicQuestionPaper[]
  academicTestProjects AcademicTestProject[]

  @@unique([branchId, courseId, facultyId, batchId])
  @@index([branchId])
  @@index([branchCourseId])
  @@index([branchFacultyId])
  @@index([courseId])
  @@index([facultyId])
  @@index([branchId, batchId])
  @@index([status])
  @@index([courseId, weekType, mode])
}

enum AcademicTestType {
  TEST
  PROJECT
  TEST_AND_PROJECT
}

enum AcademicPreparationStatus {
  DRAFT
  PREPARED
}

model AcademicTest {
  id              String              @id @default(cuid())
  branchCourseId  String
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branchCourse    BranchCourse        @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  items           AcademicTestItem[]
  batches         AcademicTestBatch[]

  @@index([branchCourseId])
  @@index([createdBy])
}

model AcademicTestItem {
  id             String           @id @default(cuid())
  academicTestId String
  sequence       Int
  testType       AcademicTestType
  requiredProgress Int          @default(0)
  testDate       String?
  testStartTime  String?
  testEndTime    String?
  projectStartDate String?
  projectEndDate   String?
  academicTest   AcademicTest     @relation(fields: [academicTestId], references: [id], onDelete: Cascade)
  questionPapers AcademicQuestionPaper[]
  projects       AcademicTestProject[]

  @@unique([academicTestId, sequence])
  @@index([academicTestId])
}

model AcademicTestBatch {
  id             String       @id @default(cuid())
  academicTestId String
  branchBatchId  String
  academicTest   AcademicTest @relation(fields: [academicTestId], references: [id], onDelete: Cascade)
  branchBatch    BranchBatch  @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)

  @@unique([academicTestId, branchBatchId])
  @@index([branchBatchId])
}

model AcademicQuestionPaper {
  id               String                    @id @default(cuid())
  academicTestItemId String
  branchCourseId   String
  branchBatchId    String
  createdBy        String
  status           AcademicPreparationStatus @default(DRAFT)
  marksPerQuestion Int                       @default(1)
  totalQuestions   Int                       @default(0)
  totalMarks       Int                       @default(0)
  passMark         Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  academicTestItem AcademicTestItem          @relation(fields: [academicTestItemId], references: [id], onDelete: Cascade)
  branchCourse     BranchCourse              @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchBatch      BranchBatch               @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)
  questions        AcademicQuestion[]

  @@unique([academicTestItemId, branchBatchId])
  @@index([branchCourseId, branchBatchId])
  @@index([createdBy])
}

model AcademicQuestion {
  id             String                @id @default(cuid())
  questionPaperId String
  questionNumber Int
  questionType   String                @default("MCQ")
  questionText   String
  optionA        String                @default("")
  optionB        String                @default("")
  optionC        String                @default("")
  optionD        String                @default("")
  correctAnswer  String                @default("")
  marks          Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  questionPaper  AcademicQuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  @@unique([questionPaperId, questionNumber])
  @@index([questionPaperId])
}

model AcademicTestProject {
  id                 String                    @id @default(cuid())
  academicTestItemId String
  branchCourseId     String
  branchBatchId      String
  createdBy          String
  status             AcademicPreparationStatus @default(DRAFT)
  projectTitle       String                    @default("")
  projectDescription String                    @default("")
  projectRequirements String?
  projectMarks       Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  academicTestItem   AcademicTestItem          @relation(fields: [academicTestItemId], references: [id], onDelete: Cascade)
  branchCourse       BranchCourse              @relation(fields: [branchCourseId], references: [id], onDelete: Cascade)
  branchBatch        BranchBatch               @relation(fields: [branchBatchId], references: [id], onDelete: Cascade)

  @@unique([academicTestItemId, branchBatchId])
  @@index([branchCourseId, branchBatchId])
  @@index([createdBy])
}

model AcademicScheduledTest {
  id                 String   @id @default(cuid())
  academicTestItemId String
  branchCourseId     String
  branchBatchId      String
  facultyId          String
  questionPaperId    String
  testNumber         Int
  testDate           String?
  startTime          String?
  endTime            String?
  projectStartDate   String?
  projectEndDate     String?
  status             String   @default("SCHEDULED")
  isRetest           Boolean  @default(false)
  originalScheduleId String?
  parentScheduleId   String?
  attemptNumber      Int      @default(1)
  retestStudentId    String?
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([academicTestItemId, branchBatchId])
  @@index([branchBatchId, testDate])
  @@index([facultyId])
  @@index([questionPaperId])
  @@index([originalScheduleId, retestStudentId])
  @@index([parentScheduleId])
}

model AcademicTestSubmission {
  id             String   @id @default(cuid())
  academicTestId String
  branchStudentId String
  submittedAt    DateTime?
  status         String   @default("NOT_STARTED")
  totalQuestions Int
  attemptedCount Int      @default(0)
  correctCount   Int      @default(0)
  wrongCount     Int      @default(0)
  unmarkedCount  Int      @default(0)
  totalMarks     Int
  obtainedMarks  Int      @default(0)
  percentage     Float    @default(0)
  resultStatus   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([academicTestId, branchStudentId])
  @@index([branchStudentId, status])
}

model AcademicProjectSubmission {
  id             String   @id @default(cuid())
  academicTestId String
  branchStudentId String
  status         String   @default("NOT_SUBMITTED")
  submissionText String?
  fileName       String?
  fileMimeType   String?
  filePath       String?
  link           String?
  marksAwarded   Int?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([academicTestId, branchStudentId])
  @@index([branchStudentId, status])
}

model AcademicTestAnswer {
  id             String  @id @default(cuid())
  submissionId   String
  questionId     String
  answerText     String?
  selectedAnswer String?
  isCorrect      Boolean @default(false)
  marksAwarded   Int     @default(0)
  evaluationStatus String @default("PENDING")
  evaluatedBy    String?
  evaluatedAt    DateTime?

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model CourseStatusHistory {
  id         String        @id @default(cuid())
  courseId   String
  fromStatus RecordStatus?
  toStatus   RecordStatus
  changedBy  String?
  reason     String?
  changedAt  DateTime      @default(now())
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, changedAt])
}

model BatchStatusHistory {
  id         String       @id @default(cuid())
  batchId    String
  fromStatus BatchStatus?
  toStatus   BatchStatus
  changedBy  String?
  reason     String?
  changedAt  DateTime     @default(now())
  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, changedAt])
}

model StudentProfile {
  id                      String              @id @default(cuid())
  studentCode             String              @unique
  studentName             String
  mobileNumber            String              @unique
  emailAddress            String              @unique
  parentSpouseNumber      String?
  location                String?
  courseId                String?
  courseInterested        String
  facultyName             String?
  batchName               String?
  qualification           String?
  passedOutYear           Int?
  currentStatus           String?
  designation             String?
  source                  String?
  actualFees              Int?
  registrationFees        Int?
  discount                Int?
  afterDiscount           Int?
  installment1            Int?
  installment2            Int?
  installment3            Int?
  totalAmount             Int?
  admissionDate           String
  firstInstallmentAmount  Int?
  firstInstallmentDate    String?
  firstInstallmentStatus  String              @default("Paid")
  firstInstallmentPaidAt  String?
  secondInstallmentAmount Int?
  secondDueDate           String?
  secondInstallmentStatus String              @default("Pending")
  secondInstallmentPaidAt String?
  remarks                 String?
  recordStatus            RecordStatus        @default(ACTIVE)
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  installment4            Int?
  batchId                 String?
  facultyId               String?
  linkedInUrl             String?
  attendanceRecords       StudentAttendance[]
  course                  Course?             @relation(fields: [courseId], references: [id])

  @@index([recordStatus])
  @@index([courseId])
  @@index([currentStatus])
  @@index([admissionDate])
}

model BranchStudent {
  id                             String                         @id @default(cuid())
  branchId                       String
  studentId                      String
  studentName                    String
  parentName                     String?
  mobileNumber                   String                         @unique
  emailAddress                   String                         @unique
  parentSpouseNumber             String?
  countryCode                    String?
  country                        String?
  stateCode                      String?
  state                          String?
  city                           String?
  address                        String?
  qualification                  String?
  passedOutYear                  String?
  currentStatus                  String?
  designation                    String?
  source                         String?
  sourceOther                    String?
  admissionDate                  String
  courseStartDate                String?
  classSchedule                  String?
  recordStatus                   RecordStatus                   @default(ACTIVE)
  createdBy                      String?
  updatedBy                      String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  linkedInUrl                    String?
  remarks                        String?
  courseId                       String?
  courseName                     String?
  courseMode                     String?
  totalWorkingDays               Int?
  courseEndDate                  String?
  batchId                        String?
  batchName                      String?
  batchTiming                    String?
  facultyId                      String?
  facultyName                    String?
  weeklyOffDay                   String?
  courseAmount                   Int?
  paymentMode                    String                         @default("Installment")
  paymentPlanId                  String?
  paymentPlan                    String?
  feeScheduleMode                String                         @default("BEFORE_70_PERCENT")
  feeFirstPaymentDate            String?
  fee70ProgressDate              String?
  fee70TargetHours               Float?
  feePaymentDeadline             String?
  feeComplianceStatus            String                         @default("PENDING")
  courseProgress                 Int?
  courseCompletedAt              DateTime?
  enrollmentType                 String                         @default("SINGLE")
  arrangementType                String                         @default("SINGLE")
  firstCourseId                  String?

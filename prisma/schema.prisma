  updatedAt           DateTime @updatedAt

  @@index([branchId, sentAt])
  @@index([facultyId, sentAt])
  @@index([batchId, courseId])
  @@index([reportType, branchId, sentAt])
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum CourseEditRequestStatus {
  PENDING
  ACCEPTED
  EDITING
  COMPLETED
  REJECTED
}

model BranchStudentPayment {
  id                   String   @id @default(cuid())
  receiptNumber        String   @unique
  branchStudentId      String
  branchId             String
  amount               Int
  paymentMode          String
  transactionReference String?
  paymentDate          DateTime
  collectedBy          String?
  notes                String?
  paymentProof         String?

  payAgainst    String?
  installmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchStudent BranchStudent             @relation(fields: [branchStudentId], references: [id])
  branch        Branch                    @relation(fields: [branchId], references: [id])
  installment   BranchStudentInstallment? @relation(fields: [installmentId], references: [id])

  @@index([branchId])
  @@index([branchStudentId])
}

model BranchStudentLedgerEntry {
  id                   String        @id @default(cuid())
  ledgerKey            String        @unique
  branchId             String
  branchStudentId      String
  paymentId            String?
  installmentId        String?
  entryNo              Int           @default(0)
  entryType            String
  description          String
  debit                Int           @default(0)
  credit               Int           @default(0)
  amount               Int           @default(0)
  runningBalance       Int           @default(0)
  studentBalanceAfter  Int           @default(0)
  entryDate            DateTime?
  paymentDate          DateTime?
  referenceType        String?
  referenceId          String?
  paymentMode          String?
  receiptNumber        String?
  payAgainst           String?
  transactionReference String?
  notes                String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  branch               Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchStudent        BranchStudent @relation(fields: [branchStudentId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([branchStudentId, entryDate, entryNo])
  @@index([branchStudentId, createdAt])
}
